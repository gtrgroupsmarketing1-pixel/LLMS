# Copy to .env.local (apps/web) or .env (root) before running dev.
# Never commit real values.

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lmms?schema=public"

# Redis (used from session 3 onward)
REDIS_URL="redis://localhost:6379"

# Auth secrets — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"

# API
PORT=4000

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Agency WhatsApp (used for support deep-links and weekly summaries)
AGENCY_WHATSAPP_NUMBER="+971500000000"

# Public app URL (used for one-tap approval links)
PUBLIC_APP_URL="http://localhost:3000"
