generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OperatingMode {
  ERP_CONNECTED
  STANDALONE
  UPGRADING
}

enum UserKind {
  AGENCY
  CLIENT
}

enum AgencyRole {
  OWNER
  ADMIN
  STRATEGIST
  DESIGNER
  OPS
}

enum ClientRole {
  OWNER
  MANAGER
  BILLING
}

enum DataSourceType {
  ERP
  CSV
  MANUAL
  WEBSITE_FORM
  WHATSAPP_OPTIN
}

enum DataSourceStatus {
  CONNECTED
  SYNCING
  STALE
  FAILED
  DISCONNECTED
}

enum ConsentChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum ConsentPurpose {
  MARKETING
  TRANSACTIONAL
  AUTHENTICATION
  SERVICE
}

enum ConsentStatus {
  OPT_IN
  OPT_OUT
  PENDING
  WITHDRAWN
}

model Tenant {
  id              String        @id @default(uuid())
  nameAr          String
  nameEn          String
  mode            OperatingMode
  country         String
  currency        String
  timezone        String
  package         String
  status          String        @default("ACTIVE")
  churnRisk       Boolean       @default(false)
  upgradeReady    Boolean       @default(false)
  greenTickStatus String        @default("NOT_APPLIED")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([country, status])
}

model User {
  id           String      @id @default(uuid())
  kind         UserKind
  email        String?     @unique
  phone        String?     @unique
  passwordHash String?
  agencyRole   AgencyRole?
  clientRole   ClientRole?
  tenantId     String?
  status       String      @default("ACTIVE")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  sessions      Session[]
  refreshTokens RefreshToken[]

  @@index([tenantId, kind])
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  jti       String    @unique
  familyId  String
  hash      String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpCode {
  id         String    @id @default(uuid())
  phone      String
  hash       String
  purpose    String    @default("LOGIN")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  @@index([phone, createdAt])
}

model Location {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  address   String?
  zone      String?
  country   String
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model TenantHealthScore {
  id         String   @id @default(uuid())
  tenantId   String
  date       DateTime @default(now())
  score      Int
  components Json

  @@index([tenantId, date])
}

model UpgradeReadiness {
  id       String   @id @default(uuid())
  tenantId String
  date     DateTime @default(now())
  score    Int
  criteria Json

  @@index([tenantId, date])
}

model DataSource {
  id         String           @id @default(uuid())
  tenantId   String
  type       DataSourceType
  status     DataSourceStatus @default(CONNECTED)
  lastSyncAt DateTime?
  config     Json?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([tenantId, type])
}

model ConsentRecord {
  id         String         @id @default(uuid())
  tenantId   String
  customerId String
  channel    ConsentChannel
  purpose    ConsentPurpose @default(MARKETING)
  status     ConsentStatus
  source     String
  evidence   String?
  timestamp  DateTime       @default(now())
  expiresAt  DateTime?
  ipAddress  String?
  userAgent  String?

  @@index([tenantId, customerId, channel, purpose])
  @@index([tenantId, status])
}

model DoNotContact {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String
  reason     String
  addedBy    String
  addedAt    DateTime @default(now())

  @@unique([tenantId, customerId])
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  actor      String
  action     String
  entity     String
  timestamp  DateTime @default(now())
  consentRef String?
  hash       String?  @unique
  prevHash   String?
  immutable  Boolean  @default(true)

  @@index([tenantId, timestamp])
  @@index([tenantId, action])
}

// === V1.3 Data Ingestion additions ===

enum CSVImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

model EndCustomer {
  id              String   @id @default(uuid())
  tenantId        String
  phone           String
  email           String?
  name            String?
  language        String   @default("ar")
  zone            String?
  source          String
  externalId      String?
  consentVerified Boolean  @default(false)
  needsReview     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, needsReview])
}

model Order {
  id          String   @id @default(uuid())
  tenantId    String
  customerId  String
  externalId  String?
  orderDate   DateTime
  serviceType String?
  amount      Decimal  @db.Decimal(12, 2)
  currency    String
  status      String
  createdAt   DateTime @default(now())

  @@unique([tenantId, externalId])
  @@index([tenantId, customerId])
  @@index([tenantId, orderDate])
}

model CSVImport {
  id           String          @id @default(uuid())
  tenantId     String
  filename     String
  rowsTotal    Int             @default(0)
  rowsImported Int             @default(0)
  rowsFlagged  Int             @default(0)
  rowsFailed   Int             @default(0)
  status       CSVImportStatus @default(PENDING)
  errorReport  Json?
  startedAt    DateTime        @default(now())
  completedAt  DateTime?

  @@index([tenantId, status])
}

// === V1.4 Segmentation additions ===

enum SegmentMode {
  BOTH
  ERP_ONLY
  STANDALONE_ONLY
}

model Segment {
  id            String      @id @default(uuid())
  tenantId      String
  name          String
  nameAr        String?
  mode          SegmentMode @default(BOTH)
  definition    Json
  isPrebuilt    Boolean     @default(false)
  isSystem      Boolean     @default(false)
  lastRefreshed DateTime?
  lastCount     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, mode])
  @@index([tenantId, isPrebuilt])
}

model SegmentMembership {
  segmentId  String
  customerId String
  tenantId   String
  addedAt    DateTime @default(now())

  @@id([segmentId, customerId])
  @@index([tenantId, segmentId])
  @@index([tenantId, customerId])
}

model SegmentSizeSnapshot {
  id        String   @id @default(uuid())
  tenantId  String
  segmentId String
  date      DateTime @default(now())
  size      Int

  @@index([tenantId, segmentId, date])
}

// === V1.5 WhatsApp Campaign Engine additions ===

enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
  SERVICE
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  SENDING
  SENT
  PAUSED
  CANCELLED
  FAILED
}

enum MessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  REPLIED
  FAILED
  UNDELIVERED
  OPT_OUT
}

model Template {
  id              String           @id @default(uuid())
  tenantId        String
  name            String
  category        TemplateCategory
  language        String
  bodyText        String
  variables       Json
  metaId          String?
  groupId         String?
  status          TemplateStatus   @default(DRAFT)
  version         Int              @default(1)
  rejectionReason String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([tenantId, name, language, version])
  @@index([tenantId, status])
  @@index([tenantId, groupId])
}

model TemplateGroup {
  id           String           @id @default(uuid())
  tenantId     String
  name         String
  category     TemplateCategory
  arTemplateId String?
  enTemplateId String?
  createdAt    DateTime         @default(now())

  @@unique([tenantId, name])
}

model Campaign {
  id              String         @id @default(uuid())
  tenantId        String
  segmentId       String
  name            String
  channel         String         @default("WHATSAPP")
  templateId      String
  templateGroupId String?
  status          CampaignStatus @default(DRAFT)
  scheduledAt     DateTime?
  sentAt          DateTime?
  promoCodeId     String?
  utmId           String?
  totalRecipients Int            @default(0)
  sentCount       Int            @default(0)
  deliveredCount  Int            @default(0)
  readCount       Int            @default(0)
  replyCount      Int            @default(0)
  failedCount     Int            @default(0)
  optOutCount     Int            @default(0)
  totalCost       Decimal        @default(0) @db.Decimal(12, 4)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, segmentId])
}

model Message {
  id            String            @id @default(uuid())
  tenantId      String
  campaignId    String?
  customerId    String
  channel       String            @default("WHATSAPP")
  templateId    String?
  body          String?
  status        MessageStatus     @default(QUEUED)
  metaMessageId String?
  cost          Decimal           @default(0) @db.Decimal(12, 4)
  costCategory  TemplateCategory? @default(MARKETING)
  queuedAt      DateTime          @default(now())
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  failedAt      DateTime?
  failureReason String?
  consentRef    String?
  retryCount    Int               @default(0)

  @@index([tenantId, campaignId, status])
  @@index([tenantId, customerId, status])
}

model PromoCode {
  id         String   @id @default(uuid())
  tenantId   String
  campaignId String?
  code       String
  discount   String?
  shared     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([tenantId, code])
}

model UtmParameter {
  id         String   @id @default(uuid())
  tenantId   String
  campaignId String
  source     String
  medium     String
  campaign   String
  content    String?
  fullUrl    String
  createdAt  DateTime @default(now())

  @@index([tenantId, campaignId])
}

model WhatsAppCostRate {
  id       String           @id @default(uuid())
  country  String
  category TemplateCategory
  amount   Decimal          @db.Decimal(12, 4)
  currency String

  @@unique([country, category])
}

model ServiceWindow {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String
  openedAt   DateTime
  expiresAt  DateTime
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, customerId])
  @@index([tenantId, expiresAt])
}

// === V1.6 Compliance additions ===

enum ErasureStatus {
  REQUESTED
  IN_REVIEW
  PROCESSING
  COMPLETED
  REJECTED
}

model ErasureRequest {
  id          String        @id @default(uuid())
  tenantId    String
  customerId  String
  scope       String
  status      ErasureStatus @default(REQUESTED)
  requestedAt DateTime      @default(now())
  dueAt       DateTime
  completedAt DateTime?
  notes       String?
  auditRef    String?

  @@index([tenantId, status])
}

model RetentionPolicy {
  id            String   @id @default(uuid())
  country       String
  dataType      String
  retentionDays Int
  basis         String
  updatedAt     DateTime @updatedAt

  @@unique([country, dataType])
}

model DpaTemplate {
  id         String    @id @default(uuid())
  tenantId   String
  version    Int
  contentMd  String
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([tenantId, version])
  @@index([tenantId])
}

model SmsSenderId {
  id          String    @id @default(uuid())
  tenantId    String
  country     String
  senderId    String
  regulator   String
  status      String    @default("PENDING")
  submittedAt DateTime  @default(now())
  approvedAt  DateTime?

  @@unique([tenantId, country, senderId])
}

model ConsentOptOutEvent {
  id           String         @id @default(uuid())
  tenantId     String
  customerId   String
  channel      ConsentChannel
  source       String
  processedAt  DateTime       @default(now())
  propagatedAt DateTime?

  @@index([tenantId, customerId, channel])
}
