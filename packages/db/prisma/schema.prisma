  tenantId      String        @unique
  subdomain     String        @unique
  customDomain  String?       @unique
  status        WebsiteStatus @default(DRAFT)
  theme         Json?
  brandKitId    String?
  seoDefaults   Json?
  publishedAt   DateTime?
  createdBy     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  pages WebsitePage[]
  leads WebsiteLead[]

  @@index([tenantId, status])
}

model WebsitePage {
  id           String            @id @default(uuid())
  tenantId     String
  websiteId    String
  slug         String
  titleEn      String
  titleAr      String?
  blocks       Json
  seo          Json?
  status       WebsitePageStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  website Website       @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  leads   WebsiteLead[]
  visits  WebsiteVisit[]

  @@unique([websiteId, slug])
  @@index([tenantId, status])
}

model WebsiteLead {
  id            String              @id @default(uuid())
  tenantId      String
  websiteId     String
  pageId        String?
  name          String?
  phone         String?
  email         String?
  zone          String?
  message       String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  promoCode     String?
  consentStatus WebsiteLeadConsent  @default(PENDING)
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime            @default(now())

  website Website      @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  page    WebsitePage? @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([tenantId, consentStatus])
  @@index([tenantId, createdAt])
  @@index([websiteId, createdAt])
}

model WebsiteVisit {
  id         String   @id @default(uuid())
  tenantId   String
  websiteId  String
  pageId     String
  path       String
  referrer   String?
  country    String?
  utmSource  String?
  utmMedium  String?
  utmCampaign String?
  createdAt  DateTime @default(now())

  page WebsitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([websiteId, createdAt])
}

// === V3.3 PWA+ additions ===

enum PushSubscriptionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum PushNotificationKind {
  APPROVAL_READY
  APPROVAL_DECIDED
  REVIEW_ESCALATION
  REPORT_READY
  INVOICE_SENT
  INVOICE_PAID
  MIGRATION_READY
  SYSTEM_ALERT
}

enum PushNotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  READ
}

enum OfflineActionStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED
  EXPIRED
}

model PushSubscription {
  id          String                 @id @default(uuid())
  userId      String
  tenantId    String?
  endpoint    String                 @unique
  p256dh      String
  auth        String
  userAgent   String?
  status      PushSubscriptionStatus @default(ACTIVE)
  lastUsedAt  DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([userId, status])
  @@index([tenantId])
}

model PushNotification {
  id          String                 @id @default(uuid())
  userId      String
  tenantId    String?
  kind        PushNotificationKind
  title       String
  body        String
  data        Json?
  status      PushNotificationStatus @default(QUEUED)
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  failureReason String?
  createdAt   DateTime               @default(now())

  @@index([userId, status])
  @@index([userId, readAt])
  @@index([tenantId, createdAt])
}

model OfflineAction {
  id            String              @id @default(uuid())
  userId        String
  tenantId      String?
  action        String
  payload       Json
  clientId      String              @unique
  status        OfflineActionStatus @default(PENDING)
  syncedAt      DateTime?
  failureReason String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([userId, status])
  @@index([tenantId, createdAt])
}

// === V3.4 Self-Serve Tier additions ===

enum SignupStatus {
  PENDING
  APPROVED
  REJECTED
  PROVISIONED
  ABANDONED
}

enum OnboardingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

model SignupRequest {
  id              String       @id @default(uuid())
  email           String       @unique
  contactName     String?
  businessName    String
  businessNameAr  String?
  phone           String?
  country         String
  currency        String
  status          SignupStatus @default(PENDING)
  tenantId        String?      @unique
  referralSource  String?
  rejectionReason String?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status])
  @@index([createdAt])
}

model SelfServeConfig {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  isSelfServe       Boolean  @default(true)
  maxCampaigns      Int      @default(2)
  maxMessagesMonthly Int     @default(500)
  maxLocations      Int      @default(1)
  allowCustomDomain Boolean  @default(false)
  billingProfileId  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model OnboardingTask {
  id          String               @id @default(uuid())
  tenantId    String
  key         String
  title       String
  status      OnboardingTaskStatus @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId, status])
}

// === V3.5 White-Label / Reseller Mode additions ===

enum ResellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model Reseller {
  id            String         @id @default(uuid())
  name          String
  domain        String         @unique
  status        ResellerStatus @default(PENDING)
  commissionPct Decimal        @db.Decimal(5, 2) @default(20.00)
  apiKey        String         @unique
  createdBy     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenants     Tenant[]
  whiteLabel  WhiteLabelConfig?
}

model WhiteLabelConfig {
  id            String   @id @default(uuid())
  resellerId    String   @unique
  logoUrl       String?
  faviconUrl    String?
  primaryColor  String   @default("#0f172a")
  supportEmail  String?
  customEmailFrom String?
  emailFooter   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reseller Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)
}
