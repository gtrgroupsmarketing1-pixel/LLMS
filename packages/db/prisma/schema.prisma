generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OperatingMode {
  ERP_CONNECTED
  STANDALONE
  UPGRADING
}

enum UserKind {
  AGENCY
  CLIENT
}

enum AgencyRole {
  OWNER
  ADMIN
  STRATEGIST
  DESIGNER
  OPS
}

enum ClientRole {
  OWNER
  MANAGER
  BILLING
}

enum DataSourceType {
  ERP
  CSV
  MANUAL
  WEBSITE_FORM
  WHATSAPP_OPTIN
}

enum DataSourceStatus {
  CONNECTED
  SYNCING
  STALE
  FAILED
  DISCONNECTED
}

enum ConsentChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum ConsentPurpose {
  MARKETING
  TRANSACTIONAL
  AUTHENTICATION
  SERVICE
}

enum ConsentStatus {
  OPT_IN
  OPT_OUT
  PENDING
  WITHDRAWN
}

model Tenant {
  id              String        @id @default(uuid())
  nameAr          String
  nameEn          String
  mode            OperatingMode
  country         String
  currency        String
  timezone        String
  package         String
  status          String        @default("ACTIVE")
  churnRisk       Boolean       @default(false)
  upgradeReady    Boolean       @default(false)
  greenTickStatus String        @default("NOT_APPLIED")
  resellerId      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  reseller        Reseller?     @relation(fields: [resellerId], references: [id])

  @@index([country, status])
  @@index([resellerId])
}

model User {
  id           String      @id @default(uuid())
  kind         UserKind
  email        String?     @unique
  phone        String?     @unique
  passwordHash String?
  agencyRole   AgencyRole?
  clientRole   ClientRole?
  tenantId     String?
  status       String      @default("ACTIVE")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  sessions      Session[]
  refreshTokens RefreshToken[]

  @@index([tenantId, kind])
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  jti       String    @unique
  familyId  String
  hash      String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpCode {
  id         String    @id @default(uuid())
  phone      String
  hash       String
  purpose    String    @default("LOGIN")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  @@index([phone, createdAt])
}

model Location {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  address   String?
  zone      String?
  country   String
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model TenantHealthScore {
  id         String   @id @default(uuid())
  tenantId   String
  date       DateTime @default(now())
  score      Int
  components Json

  @@index([tenantId, date])
}

model UpgradeReadiness {
  id           String    @id @default(uuid())
  tenantId     String
  date         DateTime  @default(now())
  score        Int
  criteria     Json
  tier         String    @default("MEDIUM")
  notes        String?
  pitchedAt    DateTime?
  pitchedBy    String?
  convertedAt  DateTime?
  notConvertedReason String?
  createdAt    DateTime  @default(now())

  @@unique([tenantId, date])
  @@index([tenantId, date])
  @@index([tenantId, score])
}

model DataSource {
  id         String           @id @default(uuid())
  tenantId   String
  type       DataSourceType
  status     DataSourceStatus @default(CONNECTED)
  lastSyncAt DateTime?
  config     Json?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([tenantId, type])
}

model ConsentRecord {
  id         String         @id @default(uuid())
  tenantId   String
  customerId String
  channel    ConsentChannel
  purpose    ConsentPurpose @default(MARKETING)
  status     ConsentStatus
  source     String
  evidence   String?
  timestamp  DateTime       @default(now())
  expiresAt  DateTime?
  ipAddress  String?
  userAgent  String?

  @@index([tenantId, customerId, channel, purpose])
  @@index([tenantId, status])
}

model DoNotContact {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String
  reason     String
  addedBy    String
  addedAt    DateTime @default(now())

  @@unique([tenantId, customerId])
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  actor      String
  action     String
  entity     String
  timestamp  DateTime @default(now())
  consentRef String?
  hash       String?  @unique
  prevHash   String?
  immutable  Boolean  @default(true)

  @@index([tenantId, timestamp])
  @@index([tenantId, action])
}

// === V1.3 Data Ingestion additions ===

enum CSVImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

model EndCustomer {
  id              String   @id @default(uuid())
  tenantId        String
  phone           String
  email           String?
  name            String?
  language        String   @default("ar")
  zone            String?
  source          String
  externalId      String?
  consentVerified Boolean  @default(false)
  needsReview     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, needsReview])
}

model Order {
  id          String   @id @default(uuid())
  tenantId    String
  customerId  String
  externalId  String?
  orderDate   DateTime
  serviceType String?
  amount      Decimal  @db.Decimal(12, 2)
  currency    String
  status      String
  createdAt   DateTime @default(now())

  @@unique([tenantId, externalId])
  @@index([tenantId, customerId])
  @@index([tenantId, orderDate])
}

model CSVImport {
  id           String          @id @default(uuid())
  tenantId     String
  filename     String
  rowsTotal    Int             @default(0)
  rowsImported Int             @default(0)
  rowsFlagged  Int             @default(0)
  rowsFailed   Int             @default(0)
  status       CSVImportStatus @default(PENDING)
  errorReport  Json?
  startedAt    DateTime        @default(now())
  completedAt  DateTime?

  @@index([tenantId, status])
}

// === V1.4 Segmentation additions ===

enum SegmentMode {
  BOTH
  ERP_ONLY
  STANDALONE_ONLY
}

model Segment {
  id            String      @id @default(uuid())
  tenantId      String
  name          String
  nameAr        String?
  mode          SegmentMode @default(BOTH)
  definition    Json
  isPrebuilt    Boolean     @default(false)
  isSystem      Boolean     @default(false)
  lastRefreshed DateTime?
  lastCount     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, mode])
  @@index([tenantId, isPrebuilt])
}

model SegmentMembership {
  segmentId  String
  customerId String
  tenantId   String
  addedAt    DateTime @default(now())

  @@id([segmentId, customerId])
  @@index([tenantId, segmentId])
  @@index([tenantId, customerId])
}

model SegmentSizeSnapshot {
  id        String   @id @default(uuid())
  tenantId  String
  segmentId String
  date      DateTime @default(now())
  size      Int

  @@index([tenantId, segmentId, date])
}

// === V1.5 WhatsApp Campaign Engine additions ===

enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
  SERVICE
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  SENDING
  SENT
  PAUSED
  CANCELLED
  FAILED
}

enum MessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  REPLIED
  FAILED
  UNDELIVERED
  OPT_OUT
}

model Template {
  id              String           @id @default(uuid())
  tenantId        String
  name            String
  category        TemplateCategory
  language        String
  bodyText        String
  variables       Json
  metaId          String?
  groupId         String?
  status          TemplateStatus   @default(DRAFT)
  version         Int              @default(1)
  rejectionReason String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([tenantId, name, language, version])
  @@index([tenantId, status])
  @@index([tenantId, groupId])
}

model TemplateGroup {
  id           String           @id @default(uuid())
  tenantId     String
  name         String
  category     TemplateCategory
  arTemplateId String?
  enTemplateId String?
  createdAt    DateTime         @default(now())

  @@unique([tenantId, name])
}

model Campaign {
  id              String         @id @default(uuid())
  tenantId        String
  segmentId       String
  name            String
  channel         String         @default("WHATSAPP")
  templateId      String
  templateGroupId String?
  status          CampaignStatus @default(DRAFT)
  scheduledAt     DateTime?
  sentAt          DateTime?
  promoCodeId     String?
  utmId           String?
  totalRecipients Int            @default(0)
  sentCount       Int            @default(0)
  deliveredCount  Int            @default(0)
  readCount       Int            @default(0)
  replyCount      Int            @default(0)
  failedCount     Int            @default(0)
  optOutCount     Int            @default(0)
  totalCost       Decimal        @default(0) @db.Decimal(12, 4)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, segmentId])
}

model Message {
  id            String            @id @default(uuid())
  tenantId      String
  campaignId    String?
  customerId    String
  channel       String            @default("WHATSAPP")
  templateId    String?
  body          String?
  status        MessageStatus     @default(QUEUED)
  metaMessageId String?
  cost          Decimal           @default(0) @db.Decimal(12, 4)
  costCategory  TemplateCategory? @default(MARKETING)
  queuedAt      DateTime          @default(now())
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  failedAt      DateTime?
  failureReason String?
  consentRef    String?
  retryCount    Int               @default(0)

  @@index([tenantId, campaignId, status])
  @@index([tenantId, customerId, status])
}

model PromoCode {
  id         String   @id @default(uuid())
  tenantId   String
  campaignId String?
  code       String
  discount   String?
  shared     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([tenantId, code])
}

model UtmParameter {
  id         String   @id @default(uuid())
  tenantId   String
  campaignId String
  source     String
  medium     String
  campaign   String
  content    String?
  fullUrl    String
  createdAt  DateTime @default(now())

  @@index([tenantId, campaignId])
}

model WhatsAppCostRate {
  id       String           @id @default(uuid())
  country  String
  category TemplateCategory
  amount   Decimal          @db.Decimal(12, 4)
  currency String

  @@unique([country, category])
}

model ServiceWindow {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String
  openedAt   DateTime
  expiresAt  DateTime
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, customerId])
  @@index([tenantId, expiresAt])
}

// === V1.6 Compliance additions ===

enum ErasureStatus {
  REQUESTED
  IN_REVIEW
  PROCESSING
  COMPLETED
  REJECTED
}

model ErasureRequest {
  id          String        @id @default(uuid())
  tenantId    String
  customerId  String
  scope       String
  status      ErasureStatus @default(REQUESTED)
  requestedAt DateTime      @default(now())
  dueAt       DateTime
  completedAt DateTime?
  notes       String?
  auditRef    String?

  @@index([tenantId, status])
}

model RetentionPolicy {
  id            String   @id @default(uuid())
  country       String
  dataType      String
  retentionDays Int
  basis         String
  updatedAt     DateTime @updatedAt

  @@unique([country, dataType])
}

model DpaTemplate {
  id         String    @id @default(uuid())
  tenantId   String
  version    Int
  contentMd  String
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([tenantId, version])
  @@index([tenantId])
}

model SmsSenderId {
  id          String    @id @default(uuid())
  tenantId    String
  country     String
  senderId    String
  regulator   String
  status      String    @default("PENDING")
  submittedAt DateTime  @default(now())
  approvedAt  DateTime?

  @@unique([tenantId, country, senderId])
}

model ConsentOptOutEvent {
  id           String         @id @default(uuid())
  tenantId     String
  customerId   String
  channel      ConsentChannel
  source       String
  processedAt  DateTime       @default(now())
  propagatedAt DateTime?

  @@index([tenantId, customerId, channel])
}

// === V1.7 Automations additions ===

enum AutomationStatus {
  ACTIVE
  PAUSED
  KILLED
  DRAFT
}

enum AutomationMode {
  ERP_ONLY
  STANDALONE_ONLY
  BOTH
}

enum AutomationRunStatus {
  ENTERED
  MESSAGED
  EXITED
  SKIPPED
  FAILED
}

model Automation {
  id                String           @id @default(uuid())
  tenantId          String
  slug              String
  name              String
  nameAr            String?
  mode              AutomationMode
  status            AutomationStatus @default(ACTIVE)
  priority          Int              @default(100)
  definition        Json
  templateId        String?
  segmentId         String?
  frequencyCapHours Int              @default(24)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, status])
}

model AutomationRun {
  id           String              @id @default(uuid())
  tenantId     String
  automationId String
  customerId   String
  status       AutomationRunStatus @default(ENTERED)
  enteredAt    DateTime            @default(now())
  exitedAt     DateTime?
  exitReason   String?
  messageId    String?
  meta         Json?

  @@index([tenantId, automationId, customerId])
  @@index([tenantId, enteredAt])
}

model FrequencyLedger {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String
  lastSendAt DateTime
  count24h   Int      @default(0)

  @@unique([tenantId, customerId])
  @@index([tenantId, lastSendAt])
}

model AutomationKillSwitch {
  id           String    @id @default(uuid())
  tenantId     String
  automationId String
  killedAt     DateTime  @default(now())
  killedBy     String
  reason       String?

  @@unique([tenantId, automationId])
}

// === V1.8 Client Portal additions ===

enum PortalTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PortalTicketKind {
  SUPPORT
  BUG
  BILLING
  ESCALATION
}

model PortalTicket {
  id         String             @id @default(uuid())
  tenantId   String
  customerId String?
  createdBy  String
  kind       PortalTicketKind   @default(SUPPORT)
  subject    String
  body       String
  status     PortalTicketStatus @default(OPEN)
  assignedTo String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model PortalInternalComment {
  id         String   @id @default(uuid())
  tenantId   String
  authorId   String
  authorKind String
  entityType String
  entityId   String
  body       String
  createdAt  DateTime @default(now())

  @@index([tenantId, entityType, entityId])
}

model PortalPreference {
  id                          String    @id @default(uuid())
  userId                      String    @unique
  language                    String    @default("ar")
  upgradePromptDismissedUntil DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
}

model ClientMessageInbox {
  id          String    @id @default(uuid())
  tenantId    String
  customerId  String
  channel     String    @default("WHATSAPP")
  direction   String
  body        String
  fromPhone   String?
  toPhone     String?
  status      String    @default("RECEIVED")
  repliedById String?
  repliedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, status])
  @@index([tenantId, customerId])
}

// === V1.9 Reporting additions ===

enum ReportKind {
  MONTHLY_PDF
  WEEKLY_SUMMARY
  QBR_DECK
}

enum ReportStatus {
  PENDING
  GENERATING
  READY
  FAILED
  DELIVERED
}

enum ReportChannel {
  WHATSAPP
  EMAIL
  PORTAL
}

model ReportRecord {
  id          String       @id @default(uuid())
  tenantId    String
  kind        ReportKind
  periodStart DateTime
  periodEnd   DateTime
  status      ReportStatus @default(PENDING)
  payload     Json?
  pdfPath     String?
  generatedAt DateTime?
  error       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  deliveries ReportDelivery[]

  @@unique([tenantId, kind, periodStart])
  @@index([tenantId, status])
  @@index([tenantId, kind, periodEnd])
}

model ReportDelivery {
  id          String        @id @default(uuid())
  reportId    String
  tenantId    String
  channel     ReportChannel
  deliveredAt DateTime      @default(now())
  meta        Json?

  report ReportRecord @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([tenantId, channel])
  @@index([reportId])
}

// === V1.10 Content Calendar additions ===

enum ContentChannel {
  WHATSAPP
  SMS
  EMAIL
  INSTAGRAM
  FACEBOOK
  GOOGLE_BUSINESS
  PRINT
  IN_STORE
}

enum ContentCardStatus {
  DRAFT
  INTERNAL_REVIEW
  CLIENT_REVIEW
  APPROVED
  SCHEDULED
  LIVE
  COMPLETED
  REJECTED
}

model ContentCard {
  id              String            @id @default(uuid())
  tenantId        String
  title           String
  brief           String?
  copyAr          String?
  copyEn          String?
  channel         ContentChannel
  scheduledAt     DateTime?
  publishedAt     DateTime?
  ownerId         String?
  status          ContentCardStatus @default(DRAFT)
  currentVersion  Int               @default(1)
  rejectionReason String?
  createdBy       String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  versions  ContentCardVersion[]
  comments  ContentCardComment[]
  approvals ContentApprovalLink[]

  @@index([tenantId, status])
  @@index([tenantId, scheduledAt])
  @@index([tenantId, channel])
}

model ContentCardVersion {
  id         String   @id @default(uuid())
  cardId     String
  tenantId   String
  version    Int
  snapshot   Json
  changedBy  String
  changedAt  DateTime @default(now())
  changeNote String?

  card ContentCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, version])
  @@index([tenantId])
}

model ContentCardComment {
  id         String   @id @default(uuid())
  cardId     String
  tenantId   String
  authorId   String
  authorKind String
  body       String
  createdAt  DateTime @default(now())

  card ContentCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
  @@index([tenantId])
}

model ContentApprovalLink {
  id        String    @id @default(uuid())
  cardId    String
  tenantId  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  decision  String?
  reason    String?
  createdAt DateTime  @default(now())

  card ContentCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([tenantId, cardId])
  @@index([expiresAt])
}

model GccTemplate {
  id              String         @id @default(uuid())
  slug            String         @unique
  titleEn         String
  titleAr         String
  occasion        String
  country         String?
  channel         ContentChannel
  briefEn         String
  briefAr         String
  suggestedCopyEn String
  suggestedCopyAr String
  active          Boolean        @default(true)
}

// === V1.11 Migration additions ===

enum MigrationStatus {
  INITIATED
  MATCHING
  AWAITING_REVIEW
  BACKFILLING
  COMPLETED
  FAILED
  ROLLED_BACK
}

enum MatchStatus {
  MATCHED_PHONE
  MATCHED_EMAIL
  MATCHED_MANUAL
  UNMATCHED
  AMBIGUOUS
}

model MigrationJob {
  id            String          @id @default(uuid())
  tenantId      String
  fromMode      String
  toMode        String
  status        MigrationStatus @default(INITIATED)
  actorId       String
  startedAt     DateTime        @default(now())
  completedAt   DateTime?
  rolledBackAt  DateTime?
  preSnapshot   Json?
  matchSummary  Json?
  backfillStats Json?
  error         String?

  matches MigrationMatch[]

  @@index([tenantId, status])
  @@index([tenantId, startedAt])
}

model MigrationMatch {
  id             String      @id @default(uuid())
  jobId          String
  tenantId       String
  lmmsCustomerId String
  erpExternalId  String?
  status         MatchStatus
  confidence     Int         @default(0)
  resolvedBy     String?
  resolvedAt     DateTime?
  notes          String?
  createdAt      DateTime    @default(now())

  job MigrationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, lmmsCustomerId])
  @@index([jobId, status])
  @@index([tenantId])
}

model MigrationEvent {
  id        String   @id @default(uuid())
  jobId     String
  tenantId  String
  step      String
  message   String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
  @@index([tenantId])
}

// === V2.2 Full Journey Builder additions ===

enum JourneyStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum JourneyRunStatus {
  ENTERED
  RUNNING
  MESSAGED
  COMPLETED
  EXITED
  FAILED
}

enum JourneyNodeType {
  TRIGGER
  WAIT
  CONDITION
  SEND
  SPLIT
  END
}

model Journey {
  id                String        @id @default(uuid())
  tenantId          String
  name              String
  nameAr            String?
  status            JourneyStatus @default(DRAFT)
  priority          Int           @default(100)
  frequencyCapHours Int           @default(24)
  definition        Json
  currentVersion    Int           @default(1)
  createdBy         String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  versions     JourneyVersion[]
  runs         JourneyRun[]
  killSwitches JourneyKillSwitch[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
}

model JourneyVersion {
  id         String   @id @default(uuid())
  journeyId  String
  tenantId   String
  version    Int
  snapshot   Json
  changedBy  String
  changeNote String?
  changedAt  DateTime @default(now())

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@unique([journeyId, version])
  @@index([tenantId])
}

model JourneyRun {
  id         String           @id @default(uuid())
  tenantId   String
  journeyId  String
  customerId String
  status     JourneyRunStatus @default(ENTERED)
  enteredAt  DateTime         @default(now())
  exitedAt   DateTime?
  exitReason String?
  currentNodeId String?
  meta       Json?

  journey Journey       @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  steps   JourneyStep[]

  @@index([tenantId, journeyId, customerId])
  @@index([tenantId, enteredAt])
  @@index([tenantId, status])
}

model JourneyStep {
  id        String   @id @default(uuid())
  runId     String
  tenantId  String
  nodeId    String
  nodeType  JourneyNodeType
  enteredAt DateTime @default(now())
  exitedAt  DateTime?
  outcome   String?
  meta      Json?

